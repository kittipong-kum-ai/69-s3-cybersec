# REST

@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@adminFirstname = {{$dotenv ADMIN_FIRSTNAME}}
@adminLastname = {{$dotenv ADMIN_LASTNAME}}
@adminResetToken = {{$dotenv ADMIN_RESET_TOKEN}}
@adminNewPassword = {{$dotenv ADMIN_NEW_PASSWORD}}
@rememberMe = {{$dotenv REMEMBER_ME}}
@adminToken = {{$dotenv ADMIN_TOKEN}}
@userUsername = {{$dotenv USER_USERNAME}}
@userEmail = {{$dotenv USER_EMAIL}}
@userPassword = {{$dotenv USER_PASSWORD}}
@userIdentifier = {{$dotenv USER_IDENTIFIER}}
@userResetCode = {{$dotenv USER_RESET_CODE}}
@userNewPassword = {{$dotenv USER_NEW_PASSWORD}}
@userToken = {{$dotenv USER_TOKEN}}
# id จาก response ของ 3.1.1 (เปลี่ยนทุกครั้งที่สร้างใหม่)
@studentId = 3

## 1. Admin Section
### 1.1 Login
POST http://localhost:8080/admin/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "rememberMe": {{rememberMe}}
}

### 1.2 Signup
POST http://localhost:8080/admin/register
Content-Type: application/json

{
    "firstname": "{{adminFirstname}}",
    "lastname": "{{adminLastname}}",
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

### 1.3 Forgot Password
POST http://localhost:8080/admin/forgot-password
Content-Type: application/json

{
    "email": "{{adminEmail}}"
}

### 1.3.1 Reset Password
POST http://localhost:8080/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{adminResetToken}}",
    "password": "{{adminNewPassword}}"
}

### 1.4 Profile
GET http://localhost:8080/admin/users/me
Authorization: Bearer {{adminToken}}


## 2. User Section
### 2.1 Login
POST http://localhost:8080/api/auth/local
Content-Type: application/json

{
    "identifier": "{{userIdentifier}}",
    "password": "{{userPassword}}"
}

### 2.2 Signup
POST http://localhost:8080/api/auth/local/register
Content-Type: application/json

{
    "username": "{{userUsername}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 2.3 Forgot Password
POST http://localhost:8080/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{userEmail}}"
}

### 2.3.1 Reset Password
POST http://localhost:8080/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{userResetCode}}",
    "password": "{{userNewPassword}}",
    "passwordConfirmation": "{{userNewPassword}}"
}

### 2.4 Profile
GET http://localhost:8080/api/users/me
Authorization: Bearer {{userToken}}

## 3. Content
### 3.1 Student
### 3.1.1 Create Student
POST http://localhost:8080/api/students
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "Somchai Jaidee",
        "mobile": "0891234567",
        "cardId": "1234567890123"
    }
}

### 3.1.2 Get Student
GET http://localhost:8080/api/students
Authorization: Bearer {{userToken}}

### 3.1.3 Update Student
PUT http://localhost:8080/api/students/4
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "Somsri Heesuy"
    }
}

### 3.1.4 Delete Student
DELETE http://localhost:8080/api/students/4
Authorization: Bearer {{userToken}}

### 3.1.5 Get Student by id
GET http://localhost:8080/api/students/4
Authorization: Bearer {{userToken}}

### 3.2 Teacher
### 3.2.1 Create Teacher
POST http://localhost:8080/api/teachers
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "Ajarn Witthaya Pailin"
    }
}

### 3.2.2 Get Teacher
GET http://localhost:8080/api/teachers
Authorization: Bearer {{userToken}}

### 3.2.3 Update Teacher
PUT http://localhost:8080/api/teachers/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "Miky Kitty"
  }
}

### 3.2.4 Delete Teacher
DELETE http://localhost:8080/api/teachers/1
Authorization: Bearer {{userToken}}

### 3.2.5 Get Teacher by id
GET http://localhost:8080/api/teachers/2
Authorization: Bearer {{userToken}}

### 3.3 Subject
### 3.3.1 Create Subject
POST http://localhost:8080/api/subjects
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "Cybersecurity 101"
    }
}

### 3.3.2 Get Subject
GET http://localhost:8080/api/subjects
Authorization: Bearer {{userToken}}

### 3.3.3 Update Subject
PUT http://localhost:8080/api/subjects/3
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "Domino Pizza"
  }
}

### 3.3.4 Delete Subject
DELETE http://localhost:8080/api/subjects/1
Authorization: Bearer {{userToken}}


### 3.3.5 Get Subject by id
GET http://localhost:8080/api/subjects/2
Authorization: Bearer {{userToken}}